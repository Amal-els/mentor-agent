icalAlign":"top","containerId":null,"originalText":"PULL skips Layer 5 (salience) and any active suppression — she asked, she gets it.\nPULL never skips Layer 2 (permissions) — she still cannot pull a dossier on data she may not see.","autoResize":true,"lineHeight":1.25,"index":"c0Bdu"},{"angle":0,"strokeColor":"#5c5f66","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":"AZ7CryoY1AdIybrwMhbyJ","roundness":null,"seed":338003831,"version":12,"versionNonce":672718265,"isDeleted":false,"boundElements":[],"updated":1785845417232,"link":null,"locked":false,"id":"EAKIns5eKVxZqI5a4FUjt","type":"text","x":-28621.118165298467,"y":-13287.218572890943,"width":5000,"height":75,"text":"Control intents are DETERMINISTIC — no LLM ever touches a suppression or memory write.\nThe cron door bypasses the router entirely: it already knows its intent, so it enters at the handler.","fontSize":30,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Control intents are DETERMINISTIC — no LLM ever touches a suppression or memory write.\nThe cron door bypasses the router entirely: it already knows its intent, so it enters at the handler.","autoResize":true,"lineHeight":1.25,"index":"c0Bdv"},{"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":"AZ7CryoY1AdIybrwMhbyJ","roundness":{"type":2},"seed":856916119,"version":12,"versionNonce":683128407,"isDeleted":false,"boundElements":[],"updated":1785845417232,"link":null,"locked":false,"id":"FwiJWLj5WhlN8r9YSGRrH","type":"arrow","x":-23581.118165298467,"y":-15297.218572890943,"width":1040,"height":1745,"points":[[0,0],[400,0],[400,1745],[-640,1745]],"startArrowhead":null,"endArrowhead":"arrow","elbowed":false,"startBinding":null,"endBinding":null,"index":"c0Bdx"},{"angle":0,"strokeColor":"#bbb","back