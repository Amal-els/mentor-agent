# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=aidodev-agents-hackathon-2026
GOOGLE_CLOUD_LOCATION=global

SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_TEAM_ID=your-team-id-here
# Signing secret from the Slack app's "Basic Information" page — verifies
# POST /slack/commands requests actually came from Slack (app/triggers/
# slack_signature.py). Different value from SLACK_BOT_TOKEN. Only used if
# the Slack app has Socket Mode OFF (see SLACK_APP_TOKEN below).
SLACK_SIGNING_SECRET=your-signing-secret-here
# App-level token (starts with xapp-) from "Basic Information" -> "App-Level
# Tokens", needs the connections:write scope. Only needed if the Slack app
# has Socket Mode ON — authenticates app/triggers/slack_socket_listener.py's
# persistent WebSocket connection instead of an inbound HTTP request.
SLACK_APP_TOKEN=xapp-your-app-level-token-here
LINEAR_API_KEY=lin_api_your-key-here
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-atlassian-account-email@example.com
JIRA_API_TOKEN=your-api-token-from-id.atlassian.com
# Desktop-app OAuth client JSON path for @cocal/google-calendar-mcp — also
# needs a one-time interactive consent flow (`npx @cocal/google-calendar-mcp
# auth`) before LiveCalendarClient.fetch() will actually work.
GOOGLE_OAUTH_CREDENTIALS=/path/to/gcp-oauth.keys.json
# Web OAuth client (fixed, registered redirect URIs). Used by
# app/triggers/google_oauth_router.py for the in-browser "connect Google"
# flow, and by any per-user google-docs-mcp spawn (GOOGLE_MCP_PROFILE set),
# since those per-user refresh tokens are minted by that router.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Desktop OAuth client. The shared (no-profile) google-docs-mcp token at
# ~/.config/google-docs-mcp/token.json is minted by
# `npx -y @a-bonus/google-docs-mcp auth`, whose consent flow uses a random
# http://localhost:<port> redirect that only a Desktop client accepts. That
# shared token backs EmailDeliverer (setup-link emails) and the fallback
# Gmail/Docs clients for users who haven't done the self-service connect.
# Optional — falls back to GOOGLE_CLIENT_ID/SECRET if unset (single-client
# setups where that client is itself a Desktop client).
GMAIL_MCP_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
GMAIL_MCP_CLIENT_SECRET=your-desktop-client-secret
# Symmetric key (app/core/crypto.py) encrypting every per-user Google
# refresh token stored in the database (GoogleCredential.refresh_token_
# encrypted, written by the "Connect Google" flow in app/triggers/
# google_oauth_router.py). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ⚠️ TREAT THIS AS A STABLE, DURABLE SECRET — never regenerate it casually.
# Changing (or losing) this value permanently breaks decryption of every
# already-stored Google credential (Fernet has no recovery path); nothing
# points at the old key anymore, so this can't be detected until an
# affected user's calendar/docs/gmail ingestion silently fails. REAL BUG
# FOUND (confirmed live): three real users' credentials all failed to
# decrypt because this value in the working .env didn't match whatever
# key was set when they connected — the only fix was for each of them to
# redo the "Connect Google" flow. Keep this value somewhere durable
# outside .env (password manager / secrets store), not just on one
# machine's disk, so a fresh .env checkout never silently orphans every
# connected user's Google credential.
TOKEN_ENCRYPTION_KEY=your-generated-fernet-key
# Comma-separated owner_user_id(s) app/triggers/cron_scheduler.py is allowed
# to fire a real pulse for — required, no default. This dev DB is shared
# with the test suite, which creates and links its own throwaway users; the
# scheduler refuses to start without this rather than silently scheduling
# every linked user in the table.
PULSE_SCHEDULED_OWNER_IDS=usr_amal
# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
